Функция СоздатьИзделие(ДанныеЗапроса) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("status", "error");
	Результат.Вставить("message", "");
	Результат.Вставить("stage", "VALIDATE_REQUEST");

	Попытка

		// ---------------------------------------------------------
		// VALIDATE_REQUEST
		// ---------------------------------------------------------

		Если ТипЗнч(ДанныеЗапроса) <> Тип("Структура") Тогда

			Результат.Вставить(
				"message",
				"JSON должен содержать объект с полем hexStringCodes."
			);

			Возврат Результат;

		КонецЕсли;

		ХексСтрокаКодов = "";

		Если Не ДанныеЗапроса.Свойство(
			"hexStringCodes",
			ХексСтрокаКодов
		) Тогда

			Если Не ДанныеЗапроса.Свойство(
				"ХексСтрокаКодов",
				ХексСтрокаКодов
			) Тогда

				Результат.Вставить(
					"message",
					"Отсутствует обязательное поле hexStringCodes."
				);

				Возврат Результат;

			КонецЕсли;

		КонецЕсли;

		Если ТипЗнч(ХексСтрокаКодов) <> Тип("Строка") Тогда

			Результат.Вставить(
				"message",
				"Поле hexStringCodes должно быть строкой."
			);

			Возврат Результат;

		КонецЕсли;

		Если ПустаяСтрока(СокрЛП(ХексСтрокаКодов)) Тогда

			Результат.Вставить(
				"message",
				"Поле hexStringCodes не должно быть пустым."
			);

			Возврат Результат;

		КонецЕсли;

		// ---------------------------------------------------------
		// CALL_EXISTING_CREATION_FUNCTION
		// ---------------------------------------------------------

		Результат.Вставить(
			"stage",
			"CALL_EXISTING_CREATION_FUNCTION"
		);

		ТекстРезультата =
			_кадИнтеграцияВызов.СоздатьСтандартноеИзделиеИзCAD(
				ХексСтрокаКодов
			);

		Результат.Вставить("result", ТекстРезультата);

		// ---------------------------------------------------------
		// CLASSIFY_RESULT
		// ---------------------------------------------------------

		Если СтрНайти(
			ТекстРезультата,
			"TEST_RESULT=CREATED"
		) = 1 Тогда

			Результат.Вставить("status", "success");
			Результат.Вставить(
				"message",
				"Изделие создано."
			);

		ИначеЕсли СтрНайти(
			ТекстРезультата,
			"TEST_RESULT=DUPLICATE"
		) = 1 Тогда

			Результат.Вставить("status", "duplicate");
			Результат.Вставить(
				"message",
				"Изделие с таким обозначением уже связано с ресурсом."
			);

		ИначеЕсли СтрНайти(
			ТекстРезультата,
			"TEST_RESULT=FAILED"
		) = 1 Тогда

			Результат.Вставить("status", "error");
			Результат.Вставить(
				"message",
				"Создание изделия завершилось ошибкой."
			);

		Иначе

			Результат.Вставить("status", "unknown");
			Результат.Вставить(
				"message",
				"Функция создания вернула результат неизвестного формата."
			);

		КонецЕсли;

		Результат.Вставить("stage", "FINISHED");

	Исключение

		Результат.Вставить("status", "error");
		Результат.Вставить(
			"message",
			"Ошибка вызова функции создания изделия."
		);
		Результат.Вставить(
			"stage",
			"CALL_EXISTING_CREATION_FUNCTION"
		);
		Результат.Вставить(
			"diagnostic",
			ПодробноеПредставлениеОшибки(
				ИнформацияОбОшибке()
			)
		);

	КонецПопытки;

	Возврат Результат;

КонецФункции