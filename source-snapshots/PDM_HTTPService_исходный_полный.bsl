
Функция СоздатьИзделиеPOST(Запрос) Экспорт

	Ответ = Новый HTTPСервисОтвет(200);

	Ответ.Заголовки.Вставить(
		"Content-Type",
		"application/json; charset=utf-8"
	);

	Результат = Новый Структура;
	ТелоЗапроса = "";

	// STAGE: READ_REQUEST_BODY
	Попытка

		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();

	Исключение

		Ответ = Новый HTTPСервисОтвет(400);
		Результат.Вставить("status", "error");
		Результат.Вставить(
			"message",
			"Не удалось прочитать тело запроса."
		);
		Результат.Вставить("stage", "READ_REQUEST_BODY");
		Результат.Вставить(
			"diagnostic",
			ПодробноеПредставлениеОшибки(
				ИнформацияОбОшибке()
			)
		);

		Возврат СформироватьJSONОтвет(Ответ, Результат);

	КонецПопытки;

	Если ПустаяСтрока(СокрЛП(ТелоЗапроса)) Тогда

		Ответ = Новый HTTPСервисОтвет(400);
		Результат.Вставить("status", "error");
		Результат.Вставить(
			"message",
			"Тело запроса не должно быть пустым."
		);
		Результат.Вставить("stage", "READ_REQUEST_BODY");

		Возврат СформироватьJSONОтвет(Ответ, Результат);

	КонецЕсли;

	// STAGE: PARSE_JSON
	Попытка

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);

		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);

		ЧтениеJSON.Закрыть();

	Исключение

		Ответ = Новый HTTPСервисОтвет(400);
		Результат.Вставить("status", "error");
		Результат.Вставить(
			"message",
			"Тело запроса содержит некорректный JSON."
		);
		Результат.Вставить("stage", "PARSE_JSON");
		Результат.Вставить(
			"diagnostic",
			ПодробноеПредставлениеОшибки(
				ИнформацияОбОшибке()
			)
		);

		Возврат СформироватьJSONОтвет(Ответ, Результат);

	КонецПопытки;

	// STAGE: CALL_CREATE_ITEM
	Попытка

		РезультатОбработки =
			ИнтеграцияCADHTTP.СоздатьИзделие(
				ДанныеЗапроса
			);

	Исключение

		Ответ = Новый HTTPСервисОтвет(500);
		Результат.Вставить("status", "error");
		Результат.Вставить(
			"message",
			"Ошибка выполнения СоздатьИзделие."
		);
		Результат.Вставить("stage", "CALL_CREATE_ITEM");
		Результат.Вставить(
			"diagnostic",
			ПодробноеПредставлениеОшибки(
				ИнформацияОбОшибке()
			)
		);

		Возврат СформироватьJSONОтвет(Ответ, Результат);

	КонецПопытки;

	// STAGE: SERIALIZE_RESULT
	Попытка

		Если ТипЗнч(РезультатОбработки) = Тип("Структура") Тогда

			Результат = РезультатОбработки;

		Иначе

			Результат.Вставить("status", "success");
			Результат.Вставить(
				"message",
				"Обработчик завершился без исключения."
			);
			Результат.Вставить(
				"result",
				РезультатОбработки
			);

		КонецЕсли;

	Исключение

		Ответ = Новый HTTPСервисОтвет(500);
		Результат = Новый Структура;
		Результат.Вставить("status", "error");
		Результат.Вставить(
			"message",
			"Ошибка подготовки результата."
		);
		Результат.Вставить("stage", "SERIALIZE_RESULT");
		Результат.Вставить(
			"diagnostic",
			ПодробноеПредставлениеОшибки(
				ИнформацияОбОшибке()
			)
		);

	КонецПопытки;

	Возврат СформироватьJSONОтвет(Ответ, Результат);

КонецФункции


Функция СформироватьJSONОтвет(Ответ, Данные) Экспорт

	Ответ.Заголовки.Вставить(
		"Content-Type",
		"application/json; charset=utf-8"
	);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();

	ЗаписатьJSON(ЗаписьJSON, Данные);

	ТелоОтвета = ЗаписьJSON.Закрыть();

	Ответ.УстановитьТелоИзСтроки(
		ТелоОтвета,
		КодировкаТекста.UTF8
	);

	Возврат Ответ;

КонецФункции
