Функция СоздатьИзделие(Запрос) Экспорт
    Попытка
        Тело = Запрос.ПолучитьТелоКакСтроку();
        Если ПустаяСтрока(Тело) Тогда
            Возврат ОтветJSON(400, Ложь, "EMPTY_BODY", "Тело запроса не заполнено.");
        КонецЕсли;

        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Тело);
        Данные = ПрочитатьJSON(Чтение);
        Если ТипЗнч(Данные) <> Тип("Структура") Тогда
            Возврат ОтветJSON(400, Ложь, "INVALID_JSON_OBJECT", "Ожидается JSON-объект.");
        КонецЕсли;

        Версия = Поле(Данные, "schemaVersion", "SchemaVersion");
        MessageId = НРег(СокрЛП(Поле(Данные, "messageId", "MessageId")));
        EventType = Поле(Данные, "eventType", "EventType");
        SourceSystem = Поле(Данные, "sourceSystem", "SourceSystem");
        SourceRef = Поле(Данные, "sourceRef", "SourceRef");
        ItemName = Поле(Данные, "itemName", "ItemName");
        ItemType = СокрЛП(Поле(Данные, "itemType", "ItemType"));
        Unit = СокрЛП(Поле(Данные, "unit", "Unit"));
        UsesCharacteristics = Поле(Данные, "usesCharacteristics", "UsesCharacteristics");

        Если ТипЗнч(Версия) <> Тип("Число") Или Версия <> 1 Тогда
            Возврат ОтветJSON(400, Ложь, "UNSUPPORTED_SCHEMA_VERSION", "Поддерживается только schemaVersion = 1.");
        КонецЕсли;
        Если ТипЗнч(MessageId) <> Тип("Строка") Или НЕ ЭтоUUID(MessageId) Тогда
            Возврат ОтветJSON(400, Ложь, "INVALID_MESSAGE_ID", "messageId должен быть UUID.");
        КонецЕсли;
        Если EventType <> "nomenclature.created" Тогда
            Возврат ОтветJSON(400, Ложь, "INVALID_EVENT_TYPE", "Поддерживается только nomenclature.created.");
        КонецЕсли;
        Если ТипЗнч(SourceSystem) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(SourceSystem)) Тогда
            Возврат ОтветJSON(400, Ложь, "SOURCE_SYSTEM_REQUIRED", "Не заполнено sourceSystem.");
        КонецЕсли;
        Если ТипЗнч(SourceRef) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(SourceRef)) Тогда
            Возврат ОтветJSON(400, Ложь, "SOURCE_REF_REQUIRED", "Не заполнено sourceRef.");
        КонецЕсли;
        Если ТипЗнч(ItemName) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(ItemName)) Тогда
            Возврат ОтветJSON(400, Ложь, "ITEM_NAME_REQUIRED", "Не заполнено itemName.");
        КонецЕсли;
        Если ТипЗнч(ItemType) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(ItemType)) Тогда
            Возврат ОтветJSON(400, Ложь, "ITEM_TYPE_REQUIRED", "Не заполнено itemType.");
        КонецЕсли;
        Если ТипЗнч(Unit) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(Unit)) Тогда
            Возврат ОтветJSON(400, Ложь, "UNIT_REQUIRED", "Не заполнено unit.");
        КонецЕсли;
        Если ТипЗнч(UsesCharacteristics) <> Тип("Булево") Тогда
            Возврат ОтветJSON(400, Ложь, "INVALID_CHARACTERISTICS_FLAG", "usesCharacteristics должен быть логическим.");
        КонецЕсли;
        Если UsesCharacteristics Тогда
            Возврат ОтветJSON(400, Ложь, "CHARACTERISTICS_NOT_SUPPORTED", "Номенклатура должна создаваться без характеристик.");
        КонецЕсли;

        Результат = СоздатьИлиНайтиНоменклатуру(MessageId, SourceRef, ItemName);
        Возврат ОтветJSON(Результат.КодHTTP, Результат.Успех, Результат.Код,
            Результат.Текст, ItemName, Результат.Ссылка, MessageId, Результат.Повтор);

    Исключение
        ЗаписьЖурналаРегистрации("ИнтеграцияRabbitMQ", УровеньЖурналаРегистрации.Ошибка,
            , , "HTTP_RECEIVER_ERROR; " + ОписаниеОшибки());
        Возврат ОтветJSON(500, Ложь, "INTERNAL_ERROR",
            "Внутренняя ошибка. Результат операции не подтверждён; сообщение можно повторить.");
    КонецПопытки;
КонецФункции

Функция Поле(Данные, ИмяJSON, ИмяPascal)
    Значение = Неопределено;
    Если Данные.Свойство(ИмяJSON, Значение) Тогда Возврат Значение; КонецЕсли;
    Если Данные.Свойство(ИмяPascal, Значение) Тогда Возврат Значение; КонецЕсли;
    Возврат Неопределено;
КонецФункции

Функция ЭтоUUID(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 36 Тогда Возврат Ложь; КонецЕсли;
    Если Сред(Значение,9,1) <> "-" Или Сред(Значение,14,1) <> "-"
        Или Сред(Значение,19,1) <> "-" Или Сред(Значение,24,1) <> "-" Тогда Возврат Ложь; КонецЕсли;
    БезДефисов = СтрЗаменить(Значение, "-", "");
    Для ИндексСимвола = 1 По СтрДлина(БезДефисов) Цикл
        Если Найти("0123456789abcdef", НРег(Сред(БезДефисов, ИндексСимвола, 1))) = 0 Тогда Возврат Ложь; КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция СоздатьИлиНайтиНоменклатуру(MessageId, SourceRef, ItemName)
    Р = Новый Структура("Успех,КодHTTP,Код,Текст,Ссылка,Повтор", Ложь, 500, "PROCESSING_ERROR", "Операция не подтверждена.", "", Ложь);
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        БлокТаблицы = Блокировка.Добавить("Справочник.Номенклатура");
        БлокТаблицы.Режим = РежимБлокировкиДанных.Исключительный;
        БлокСообщений = Блокировка.Добавить("РегистрСведений.Расш1_ОбработанныеСообщения");
        БлокСообщений.Режим = РежимБлокировкиДанных.Исключительный;
        БлокСообщений.УстановитьЗначение("MessageId", MessageId);
        Блокировка.Заблокировать();

        Запись = РегистрыСведений.Расш1_ОбработанныеСообщения.СоздатьМенеджерЗаписи();
        Запись.MessageId = MessageId;
        Запись.Прочитать();
        Если Запись.Выбран() Тогда
            Если Запись.SourceRef <> SourceRef Или Запись.ItemName <> ItemName Тогда
                ОтменитьТранзакцию();
                Р.КодHTTP = 409; Р.Код = "MESSAGE_ID_CONFLICT";
                Р.Текст = "MessageId ранее использован для другого сообщения.";
                Возврат Р;
            КонецЕсли;
            Если ПустаяСтрока(Запись.NomenclatureRef) Тогда
                ОтменитьТранзакцию();
                Р.КодHTTP = 500; Р.Код = "INCOMPLETE_PREVIOUS_RESULT";
                Р.Текст = "Для ранее обработанного сообщения отсутствует ссылка результата.";
                Возврат Р;
            КонецЕсли;
            ЗафиксироватьТранзакцию();
            Р.Успех = Истина; Р.КодHTTP = 200; Р.Код = "DUPLICATE_MESSAGE";
            Р.Текст = "Сообщение уже обработано."; Р.Ссылка = Запись.NomenclatureRef; Р.Повтор = Истина;
            Возврат Р;
        КонецЕсли;

        Ссылка = Справочники.Номенклатура.НайтиПоНаименованию(ItemName, Истина);
        Если НЕ Ссылка.Пустая() И Ссылка.Наименование <> ItemName Тогда
            Ссылка = Справочники.Номенклатура.ПустаяСсылка();
        КонецЕсли;

        Если Ссылка.Пустая() Тогда
            Элемент = Справочники.Номенклатура.СоздатьЭлемент();
            Элемент.Наименование = ItemName;
            Элемент.ИспользованиеХарактеристик =
                Перечисления.ВариантыВеденияДополнительныхДанныхПоНоменклатуре.НеИспользовать;
            Элемент.Записать();
            Ссылка = Элемент.Ссылка;
            Код = "CREATED"; Текст = "Позиция номенклатуры создана."; КодHTTP = 201;
        Иначе
            Код = "ALREADY_EXISTS"; Текст = "Позиция с точным наименованием уже существует."; КодHTTP = 200;
        КонецЕсли;

        Запись = РегистрыСведений.Расш1_ОбработанныеСообщения.СоздатьМенеджерЗаписи();
        Запись.MessageId = MessageId;
        Запись.SourceRef = SourceRef;
        Запись.ItemName = ItemName;
        Запись.NomenclatureRef = Строка(Ссылка.УникальныйИдентификатор());
        Запись.ResultCode = Код;
        Запись.ProcessedAt = ТекущаяДатаСеанса();
        Запись.Записать();
        ЗафиксироватьТранзакцию();

        Р.Успех = Истина; Р.КодHTTP = КодHTTP; Р.Код = Код; Р.Текст = Текст; Р.Ссылка = Строка(Ссылка.УникальныйИдентификатор());
        Возврат Р;
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        ОтменитьТранзакцию();
        ЗаписьЖурналаРегистрации("ИнтеграцияRabbitMQ", УровеньЖурналаРегистрации.Ошибка,
            , , "NOMENCLATURE_TRANSACTION_ERROR; MessageId=" + MessageId + "; " + ТекстОшибки);
        Р.КодHTTP = 500; Р.Код = "TRANSACTION_FAILED";
        Р.Текст = "Операция не подтверждена; сообщение можно повторить.";
        Возврат Р;
    КонецПопытки;
КонецФункции

Функция ОтветJSON(КодHTTP, Успех, Код, Текст, ItemName = "", Ссылка = "", MessageId = "", Повтор = Ложь)
    Ответ = Новый HTTPСервисОтвет(КодHTTP);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Данные = Новый Структура;
    Данные.Вставить("success", Успех);
    Данные.Вставить("code", Код);
    Данные.Вставить("message", Текст);
    Если НЕ ПустаяСтрока(ItemName) Тогда Данные.Вставить("itemName", ItemName); КонецЕсли;
    Если НЕ ПустаяСтрока(Ссылка) Тогда Данные.Вставить("nomenclatureRef", Ссылка); КонецЕсли;
    Если НЕ ПустаяСтрока(MessageId) Тогда Данные.Вставить("messageId", MessageId); КонецЕсли;
    Данные.Вставить("duplicateMessage", Повтор);
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
    Возврат Ответ;
КонецФункции